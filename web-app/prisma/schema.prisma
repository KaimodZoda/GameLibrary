generator client {
  provider = "prisma-client-js"
}

// Migration checklist: see prisma/MIGRATION_CHECKLIST.md
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum LoanStatus {
  pending
  approved
  picked_up
  returned
  rejected
}

enum ReturnStatus {
  pending
  approved
  completed
}

enum ReturnMethod {
  IN_PERSON @map("in-person")
  DROP_BOX  @map("drop-box")
  SHIPPING  @map("shipping")
  COURIER   @map("courier")
}

enum AdminActionType {
  loan_approved
  loan_rejected
  return_approved
  return_rejected
  return_completed
  loan_picked_up
}

model User {
  id            Int           @id @default(autoincrement())
  email         String        @unique
  password      String
  name          String
  role          UserRole      @default(USER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  adminActions  AdminAction[]
  approvedLoans Loan[]        @relation("LoanApprover")
  loans         Loan[]
}

model Game {
  id           Int           @id @default(autoincrement())
  title        String
  platform     String
  genre        String
  available    Boolean       @default(true)
  gradient     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  loans        Loan[]
}

model Loan {
  id               Int           @id @default(autoincrement())
  userId           Int
  gameId           Int
  dateBorrowed    DateTime      @default(now())
  dueDate          DateTime
  approvedBy       Int?
  approvedAt       DateTime?
  completedBy      Int?
  pickupDate       DateTime?
  completedAt       DateTime?
  status           LoanStatus    @default(pending) // 'pending', 'approved', 'picked_up', 'returned', 'rejected'
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  
  // Relations
  user             User          @relation(fields: [userId], references: [id])
  game             Game          @relation(fields: [gameId], references: [id])
  approver         User?         @relation("LoanApprover", fields: [approvedBy], references: [id])
  returnRequest    Return?
  adminActions     AdminAction[]
  @@unique([userId, gameId, dateBorrowed])
}

model Return {
  id                  Int       @id @default(autoincrement())
  loanId              Int       @unique
  requestedReturnDate DateTime  @default(now())
  approvedAt         DateTime?
  approvedBy        Int?
  completedBy       Int?
  completedAt        DateTime?
  estimatedReturnDate DateTime?
  returnMethod        ReturnMethod?
  trackingNumber      String?
  returnNotes         String?
  status              ReturnStatus @default(pending) // 'pending', 'approved', 'completed'
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Relations
  loan         Loan        @relation(fields: [loanId], references: [id])
  adminActions AdminAction[]
}

model AdminAction {
  id           Int      @id @default(autoincrement())
  loanId       Int?
  returnId     Int?
  adminId      Int
  action       AdminActionType
  actionDate   DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  loan         Loan?    @relation(fields: [loanId], references: [id])
  return       Return?  @relation(fields: [returnId], references: [id])
  admin        User     @relation(fields: [adminId], references: [id])
  
  @@map("admin_actions")
}
