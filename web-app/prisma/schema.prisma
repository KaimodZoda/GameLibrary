generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int           @id @default(autoincrement())
  email         String        @unique
  password      String
  name          String
  role          String        @default("USER")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  adminActions  AdminAction[]
  approvedLoans Loan[]        @relation("LoanApprover")
  loans         Loan[]
}

model Game {
  id           Int           @id @default(autoincrement())
  title        String
  platform     String
  genre        String
  available    Boolean       @default(true)
  gradient     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  loans        Loan[]
}

model Loan {
  id               Int           @id @default(autoincrement())
  userId           Int
  gameId           Int
  dateBorrowed    DateTime      @default(now())
  dueDate          DateTime
  approvedBy       Int?
  approvedAt       DateTime?
  completedBy      Int?
  pickupDate       DateTime?
  completedAt       DateTime?
  status           String        @default("pending") // 'pending', 'approved', 'completed'
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  
  // Relations
  user             User          @relation(fields: [userId], references: [id])
  game             Game          @relation(fields: [gameId], references: [id])
  approver         User?         @relation("LoanApprover", fields: [approvedBy], references: [id])
  adminActions     AdminAction[]
  @@unique([userId, gameId, dateBorrowed])
}

model Return {
  id                  Int       @id @default(autoincrement())
  loanId              Int       @unique
  requestedReturnDate DateTime  @default(now())
  approvedAt         DateTime?
  approvedBy        Int?
  completedBy       Int?
  completedAt        DateTime?
  estimatedReturnDate DateTime?
  returnMethod        String?   // 'in-person', 'drop-box', 'shipping', 'courier'
  trackingNumber      String?
  returnNotes         String?
  status              String    @default("pending") // 'pending', 'approved', 'completed'
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Relations
  adminActions AdminAction[]
}

model AdminAction {
  id           Int      @id @default(autoincrement())
  loanId       Int?
  returnId     Int?
  adminId      Int
  action       String   // 'loan_approved', 'loan_rejected', 'return_approved', 'return_rejected'
  actionDate   DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  loan         Loan?    @relation(fields: [loanId], references: [id])
  return       Return?  @relation(fields: [returnId], references: [id])
  admin        User     @relation(fields: [adminId], references: [id])
  
  @@map("admin_actions")
}
