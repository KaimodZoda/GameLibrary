{
  "name": "game-library-monorepo",
  "version": "1.0.0",
  "description": "Game Library with LLM Assistant - Monorepo",
  "private": true,
  "workspaces": [
    "web-app",
    "services/*"
  ],
  "scripts": {
    "dev:web": "cd web-app && npm run dev",
    "build:web": "cd web-app && npm run build",
    "start:web": "cd web-app && npm start",
    "dev:services": "concurrently \"npm run dev:llm\"",
    "dev:llm": "cd services/llm-assistant && python main.py",
    "install:all": "npm install && cd web-app && npm install && cd ../services/llm-assistant && pip install -r requirements.txt",
    "build:all": "npm run build:web"
  },
  "devDependencies": {
    "concurrently": "^7.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
