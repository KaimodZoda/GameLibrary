// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("USER") // USER or ADMIN (string for SQLite)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  loans         Loan[]
  approvedLoans Loan[]        @relation("LoanApprover")
  returnedLoans Loan[]        @relation("ReturnApprover")
  userRequests  UserRequest[]
  adminActions  AdminAction[]
}

model Game {
  id        Int      @id @default(autoincrement())
  title     String
  platform  String
  genre     String
  available Boolean  @default(true)
  gradient  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  loans        Loan[]
  userRequests UserRequest[]
}

model Loan {
  id               Int       @id @default(autoincrement())
  userId           Int
  gameId           Int
  dateBorrowed     DateTime  @default(now())
  dueDate          DateTime
  approvedAt       DateTime?
  approvedBy       Int?
  returnedAt       DateTime?
  returnApprovedAt DateTime?
  returnApprovedBy Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  user           User          @relation(fields: [userId], references: [id])
  game           Game          @relation(fields: [gameId], references: [id])
  approver       User?         @relation("LoanApprover", fields: [approvedBy], references: [id])
  returnApprover User?         @relation("ReturnApprover", fields: [returnApprovedBy], references: [id])
  userRequest    UserRequest[]
  adminActions   AdminAction[]

  @@unique([userId, gameId, dateBorrowed])
}

model UserRequest {
  id                  Int       @id @default(autoincrement())
  userId              Int
  gameId              Int
  type                String    @default("pending") // borrow_request, return_request
  requestedDate       DateTime  @default(now())
  requestedPickupDate DateTime?
  estimatedReturnDate DateTime?
  status              String    @default("pending") // pending, approved, rejected
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id])
  game         Game          @relation(fields: [gameId], references: [id])
  adminActions AdminAction[]
  loan         Loan?         @relation(fields: [loanId], references: [id])
  loanId       Int?
}

model AdminAction {
  id         Int      @id @default(autoincrement())
  requestId  Int
  adminId    Int
  action     String // 'approve', 'reject', 'confirm_pickup', 'confirm_return'
  actionDate DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  request UserRequest @relation(fields: [requestId], references: [id])
  admin   User        @relation(fields: [adminId], references: [id])
  loan    Loan[]
}
